# Copy to .env.local for local work, and set the same names in your hosting
# provider's build environment. NEXT_PUBLIC_* values are read at BUILD time, so
# redeploy after changing them. Leave a line out (or empty) to switch it off.
# Google tags only run in production builds, never under `pnpm dev`.

# Public address of the site, used for canonical URLs, sitemap and social cards.
# Set it on staging so previews never claim the live domain.
# NEXT_PUBLIC_SITE_URL=https://www.sgmathwizard.com

# Google Tag Manager: Admin > Container ID, looks like GTM-ABC123.
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4: Admin > Data streams > Measurement ID, looks like G-ABC123DEF4.
# Leave empty if your Tag Manager container already fires the GA4 tag, or visits
# are counted twice.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console: Add property > URL prefix > "HTML tag". Paste only the
# content="..." value, not the whole <meta> tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
